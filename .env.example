# Copy to .env (never commit .env) and fill in.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CC_SECRET_KEY=

# SQL Server with the cc_* tables
CC_SQL_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=host\instance;DATABASE=visteon_test;UID=user;PWD=password;TrustServerCertificate=yes;Connection Timeout=10;

# Azure SQL (SAP_QADPRD) used for the BOM explosion
CC_AZURE_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=tcp:host.database.windows.net,1433;DATABASE=SAP_QADPRD;UID=user;PWD=password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=20;

# MySQL (machine/feeder usage)
CC_MYSQL_HOST=
CC_MYSQL_PORT=3306
CC_MYSQL_USER=
CC_MYSQL_PASSWORD=
CC_MYSQL_DATABASE=vdb

# Folder with the REF CODES-CIMPLE_* workbooks
CC_REF_CODES_DIR=W:\sharedir\MP&L\Inventory\Utils\REF CODES

# Email
CC_SMTP_HOST=vistsmtp.visteon.com
CC_SMTP_PORT=25
CC_SMTP_TLS=false
CC_MAIL_FROM=noreply@visteon.com

# Optional
CC_DISPLAY_TZ=Europe/Lisbon
CC_SESSION_DAYS=14
# Set to true when the app is served over HTTPS
CC_SESSION_COOKIE_SECURE=false
